# Copy to .env.local and fill in. Never commit real values.

# Public URL of the deployed site (used in emails and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API Keys). The publishable key is public by design; RLS protects data.
# Legacy names NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are also accepted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only. Bypasses RLS: never expose to the browser.
SUPABASE_SECRET_KEY=
# "true" after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH=false

# AI (server only). Groq is required; Gemini is an optional free-tier fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Support email via Gmail SMTP (use a Google App Password).
SMTP_USER=
SMTP_PASS=
SUPPORT_INBOX=
OWNER_EMAIL=

# Random string used to hash IP addresses for rate limits.
IP_HASH_SALT=
